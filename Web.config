<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
-->
<configuration>
	<!-- Sprint 2: email settings are read from Secrets.config (not in GitHub). The site still runs if that file is missing. -->
	<appSettings file="Secrets.config">
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
		<add key="Notifications:BaseUrl" value="https://localhost:44347/" />
	</appSettings>
	<!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
	<connectionStrings>
		<add name="DefaultConnection"
			 connectionString="Data Source=(localdb)\ProjectModels;Initial Catalog=CyberAppDB;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
	<system.web>
		<compilation debug="true" targetFramework="4.8"/>
		<!-- Security: framework version matches the compilation setting; the X-AspNet-Version header is not sent -->
		<httpRuntime targetFramework="4.8" enableVersionHeader="false"/>
		<!-- Security: remote visitors get a plain error page (no stack traces or file paths). Developers on this machine still see full errors. -->
		<customErrors mode="RemoteOnly" defaultRedirect="~/Error.html"/>
		<!-- Security Hardening: session expires after 15 minutes of inactivity -->
		<sessionState mode="InProc" timeout="15" cookieless="UseCookies" regenerateExpiredSessionId="true"/>
		<!-- Security Hardening: cookies are HttpOnly and Secure in every build (the site is always served over https, see Global.asax), and SameSite=Lax keeps them off cross-site POSTs -->
		<httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax"/>
	</system.web>
	<!-- Sprint 2: email settings live in smtp.config (not committed to GitHub) -->
	<system.net>
		<mailSettings>
			<smtp configSource="smtp.config" />
		</mailSettings>
	</system.net>
	<system.webServer>
		<!-- Security: response headers sent with every page and file. -->
		<httpProtocol>
			<customHeaders>
				<remove name="X-Powered-By"/>
				<add name="X-Content-Type-Options" value="nosniff"/>
				<add name="X-Frame-Options" value="DENY"/>
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin"/>
				<add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()"/>
				<!-- Frame/form/base rules only. A full script-src policy would need the pages' inline scripts reworked first. -->
				<add name="Content-Security-Policy" value="frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"/>
			</customHeaders>
		</httpProtocol>
		<defaultDocument>
			<files>
				<clear/>
				<add value="Welcome_Page.aspx"/>
			</files>
		</defaultDocument>
	</system.webServer>
	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701"/>
			<compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
		</compilers>
	</system.codedom>
</configuration>